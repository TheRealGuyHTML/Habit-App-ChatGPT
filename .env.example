# Leave every Firebase field empty for fully local mode.
# Public Firebase Web App configuration, from Firebase Console > Project settings.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Optional: used only if required by your Firebase configuration.
VITE_FIREBASE_MESSAGING_SENDER_ID=

# Public VAPID key only. The private key belongs in Cloud Secret Manager.
VITE_VAPID_PUBLIC_KEY=

# Development only: true connects to the local Firebase emulators.
VITE_USE_FIREBASE_EMULATORS=false
